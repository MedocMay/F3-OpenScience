# ===== Open-Sci 部署配置(复制为 .env 按需填写)=====

# --- 网关(所有模式)---
PORT=8080
OPENSCI_DB=./data/gateway_mem.db
OPENSCI_TOKEN=                      # 云端必填(Bearer 认证);本地可留空=开发放行

# --- 模型(选云 API 或本地;本地=数据不出域)---
OPENSCI_MODEL=ollama:qwen2.5        # 或 anthropic:claude-... / openai:gpt-... / deepseek:... / kimi:... / qwen:...
OLLAMA_HOST=http://localhost:11434
# 云 API key(用哪个填哪个):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_BASE=                     # 任意 OpenAI 兼容端点(vLLM/LMStudio)

# --- global 记忆(混合/云端;纯本地可不设)---
OPENSCI_GLOBAL_URL=                 # 混合:填远程 global 服务地址,如 https://global.yourorg.com
OPENSCI_GLOBAL_TOKEN=              # global 服务的 Bearer token
OPENSCI_GLOBAL_DB=./data/global.db  # 自建 global 服务时的本地库(生产换 Postgres)
