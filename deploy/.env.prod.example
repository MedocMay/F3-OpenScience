# ===== 生产部署配置(cp 为 .env.prod 填写)=====
DOMAIN=opensci.yourorg.com               # Caddy 自动 TLS 的域名
OPENSCI_ADMIN_TOKEN=                     # 管理端发 token 用;openssl rand -hex 24
OPENSCI_MASTER_KEY=                      # BYOK 主密钥;生产从 KMS/Vault 注入
OPENSCI_GLOBAL_TOKEN=                    # global 服务认证;openssl rand -hex 24
POSTGRES_PASSWORD=                       # Postgres 密码;openssl rand -hex 24
