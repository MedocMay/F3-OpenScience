{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "F3-OpenScience",
  "version": "0.2.0",
  "identifier": "fund.frontierfirm.f3openscience",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "width": 480,
        "height": 300,
        "decorations": false,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true
      },
      {
        "label": "main",
        "title": "F3-OpenScience · 可署名的科研工作台",
        "width": 1100,
        "height": 760,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "可署名的科研工作台",
    "longDescription": "F3-OpenScience —— 第一个产出前有独立校验、可署名的开源科研 Agent。校验记忆飞轮让拦截率越用越低;模型无关,支持本地部署。",
    "copyright": "© 2026 Junjie Mei (梅俊杰)",
    "publisher": "Junjie Mei",
    "licenseFile": "../../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 160,
          "y": 150
        },
        "applicationFolderPosition": {
          "x": 500,
          "y": 150
        }
      }
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}